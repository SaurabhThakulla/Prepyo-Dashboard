# =============================================================================
# Prepyo Frontend & Next.js API Environment Configuration
# =============================================================================

# Port for local dev server (default: 3000)
PORT=3000

# Base URL for API calls
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider API Keys (Optional)
# If provided, evaluation and tutor endpoints will use live models via OpenRouter or Gemini.
# If omitted, Prepyo uses its built-in intelligent simulated rubric evaluator engine.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
