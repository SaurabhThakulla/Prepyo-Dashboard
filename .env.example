# =============================================================================
# Prepyo frontend configuration
# =============================================================================
# The Next.js app stores no data of its own. Everything comes from the Go API,
# so the only thing to configure here is where that API lives.
#
# Database credentials and AI keys belong in backend/.env, not here — nothing in
# this file should be a secret, because NEXT_PUBLIC_* values are shipped to the
# browser.

# Port for the local dev server (default: 3000)
PORT=3000

# Where /api/v1/* is proxied to. See the rewrite in next.config.js.
# Defaults to http://localhost:8080 when unset.
BACKEND_URL=http://localhost:8080
