# =============================================================================
# Prepyo Frontend Configuration (Next.js)
# =============================================================================
# The Next.js frontend proxies all /api/v1/* requests to the Go API backend
# (hosted separately at https://github.com/SaurabhThakulla/Prepyo-Backend).
#
# In local development, defaults to http://localhost:8080.
# In production on Vercel, set BACKEND_URL to your deployed API URL.

PORT=3000
BACKEND_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Sample data (frontend-only development)
# -----------------------------------------------------------------------------
# Set to true to seed pages from src/data/*.json so you can build UI without a
# running backend or a login. Pages still call the API and still show real
# errors — this only fills the first render. See src/lib/fixtures.ts.
# Leave unset in production.
NEXT_PUBLIC_USE_FIXTURES=

# -----------------------------------------------------------------------------
# Issue reporting (the Report an issue button in the sidebar)
# -----------------------------------------------------------------------------
# /api/report emails each submission through Gmail. GMAIL_APP_PASSWORD is a
# Google App Password, not the account password: Google Account > Security >
# 2-Step Verification > App passwords. Without both values set the endpoint
# returns 500 and the dialog tells the reporter it is not configured.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where reports land. Defaults to sauravthakulla683@gmail.com.
REPORT_EMAIL_TO=
